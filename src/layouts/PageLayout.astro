---
// Standard layout for content pages — Layout's shell plus a consistent
// title/eyebrow/description heading. Consumed by every page except
// Home/About (which use the glass system's own bespoke <Hero> instead of
// a generic page heading): /projects (+ [slug]), /blog (+ [slug],
// /category/[category], /tags/[tag]), /services (+ [slug]), /store
// (+ [slug]).
import Layout from './Layout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** "article" for blog posts — see SEO.astro. */
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title,
	description,
	eyebrow,
	image,
	imageAlt,
	noindex,
	jsonLd,
	ogType,
	publishedTime,
	modifiedTime,
} = Astro.props;
---

<Layout
	title={title}
	description={description}
	image={image}
	imageAlt={imageAlt}
	noindex={noindex}
	jsonLd={jsonLd}
	ogType={ogType}
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	fullBleed
>
	<Section id="page-heading">
		<SectionHeading
			id="page-heading-heading"
			eyebrow={eyebrow}
			title={title}
			description={description}
			level={1}
		/>
		<slot />
	</Section>
</Layout>
