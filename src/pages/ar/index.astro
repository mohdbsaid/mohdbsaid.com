---
// Arabic/RTL counterpart of the homepage — same shared <PersonalPortfolio>
// template as src/pages/index.astro, own Arabic copy. Intentionally
// minimal — see docs/DECISIONS.md ADR-023. Uses this site's existing
// self-hosted "Thmanyah Sans" (already Arabic-capable — it's the default
// body font on every other Arabic page) instead of loading a second webfont.
// Section copy comes from src/content/pages/home/**/ar.mdx (ADR-024).
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PersonalPortfolio from '../../components/PersonalPortfolio.astro';
import { selectedWork } from '../../data/selectedWork';
import { getPageSection } from '../../lib/content';
import { site } from '../../data/site';

const locale = 'ar';

const [hero, workIntro, contact] = await Promise.all([
	getPageSection('home', 'hero', locale, 'hero'),
	getPageSection('home', 'workintro', locale, 'workintro'),
	getPageSection('home', 'contact', locale, 'contact'),
]);

const { Content: ContactContent } = await render(contact);

const title = `${site.name.ar} — ${site.title.ar}`;
const description = `${site.name.ar} أخصائي تصنيع إضافي مقيم في عُمان. تصفّح الأعمال المختارة أو تواصل معه — السيرة المهنية الكاملة متاحة في صفحة نبذة.`;
const siteUrl = Astro.site?.toString() ?? site.website;

const jsonLd = [
	{
		'@type': 'Person',
		name: site.name.ar,
		url: `${siteUrl}/ar`,
		description,
		jobTitle: site.title.ar,
		email: `mailto:${site.email}`,
	},
	{
		'@type': 'WebSite',
		name: site.name.ar,
		url: `${siteUrl}/ar`,
		inLanguage: 'ar',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="ar"
	htmlDir="rtl"
	hideChrome
	skipLinkLabel="تخطَّ إلى المحتوى الرئيسي"
	locale="ar_OM"
>
	<Fragment slot="head">
		<link rel="alternate" hreflang="ar" href={new URL('/ar', siteUrl)} />
		<link rel="alternate" hreflang="en" href={new URL('/', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />
	</Fragment>

	<PersonalPortfolio
		dir="rtl"
		email={site.email}
		whatsapp={site.whatsapp.url}
		whatsappDisplay={site.whatsapp.display}
		nav={{
			logo: { label: site.name.ar, href: '/ar' },
			links: [
				{ label: 'الأعمال', href: '#work' },
				{ label: 'نبذة', href: '/ar/about' },
				{ label: 'تواصل', href: '#contact' },
			],
		}}
		hero={{
			name: site.name.ar,
			initials: site.initials.ar,
			role: site.title.ar,
			intro: hero.data.tagline,
			emailLabel: hero.data.emailLabel,
			whatsappLabel: hero.data.whatsappLabel,
		}}
		work={{
			eyebrow: workIntro.data.eyebrow,
			heading: workIntro.data.heading,
			projects: selectedWork.map((item) => ({ icon: item.icon, ...item.ar })),
		}}
		contact={{
			eyebrow: contact.data.eyebrow,
			heading: contact.data.heading,
			Content: ContactContent,
		}}
		footer={`© ${new Date().getFullYear()} ${site.name.ar}`}
	/>
</Layout>
