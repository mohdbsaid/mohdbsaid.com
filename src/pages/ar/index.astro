---
// Arabic/RTL counterpart of the homepage — same shared <PersonalPortfolio>
// template as src/pages/index.astro, own Arabic copy. Intentionally
// minimal — see docs/DECISIONS.md ADR-023. Uses this site's existing
// self-hosted "Thmanyah Sans" (already Arabic-capable — it's the default
// body font on every other Arabic page) instead of loading a second webfont.
import Layout from '../../layouts/Layout.astro';
import PersonalPortfolio from '../../components/PersonalPortfolio.astro';
import { selectedWork } from '../../data/selectedWork';

const title = 'محمد الجابري — أخصائي التصنيع الإضافي والطباعة ثلاثية الأبعاد';
const description =
	'محمد الجابري أخصائي تصنيع إضافي مقيم في عُمان. تصفّح الأعمال المختارة أو تواصل معه — السيرة المهنية الكاملة متاحة في صفحة نبذة.';
const siteUrl = Astro.site?.toString() ?? 'https://mohdbsaid.com';
const email = 'mohdbsaid@outlook.com';
const whatsapp = 'https://wa.me/96891899818';

const jsonLd = [
	{
		'@type': 'Person',
		name: 'محمد الجابري',
		url: `${siteUrl}/ar`,
		description,
		jobTitle: 'أخصائي التصنيع الإضافي والطباعة ثلاثية الأبعاد',
		email: `mailto:${email}`,
	},
	{
		'@type': 'WebSite',
		name: 'محمد الجابري',
		url: `${siteUrl}/ar`,
		inLanguage: 'ar',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="ar"
	htmlDir="rtl"
	hideChrome
	skipLinkLabel="تخطَّ إلى المحتوى الرئيسي"
	locale="ar_OM"
>
	<Fragment slot="head">
		<link rel="alternate" hreflang="ar" href={new URL('/ar', siteUrl)} />
		<link rel="alternate" hreflang="en" href={new URL('/', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />
	</Fragment>

	<PersonalPortfolio
		dir="rtl"
		email={email}
		whatsapp={whatsapp}
		nav={{
			logo: { label: 'محمد الجابري', href: '/ar' },
			links: [
				{ label: 'الأعمال', href: '#work' },
				{ label: 'نبذة', href: '/ar/about' },
				{ label: 'تواصل', href: '#contact' },
			],
		}}
		hero={{
			name: 'محمد الجابري',
			initials: 'م ج',
			role: 'أخصائي التصنيع الإضافي والطباعة ثلاثية الأبعاد',
			intro:
				'أحوّل الأفكار إلى قطع حقيقية عبر إنتاج موثوق بتقنية FDM، وخبرة امتدت ست سنوات في هذا المجال داخل عُمان.',
			emailLabel: 'البريد الإلكتروني',
			whatsappLabel: 'واتساب',
		}}
		work={{
			eyebrow: 'الأعمال',
			heading: 'أعمال مختارة',
			projects: selectedWork.map((item) => ({ icon: item.icon, ...item.ar })),
		}}
		contact={{
			eyebrow: 'تواصل',
			heading: 'لنعمل معًا',
			paragraph:
				'أرحّب بالتواصل بشأن مشاريع التصنيع الإضافي أو التدريب التقني أو أي تحدٍّ إنتاجي تعمل عليه — يمكنك التواصل معي عبر البريد الإلكتروني أو واتساب.',
			whatsappDisplay: '+968 91899818',
		}}
		footer={`© ${new Date().getFullYear()} محمد الجابري`}
	/>
</Layout>
