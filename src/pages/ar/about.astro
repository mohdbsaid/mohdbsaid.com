---
// Arabic/RTL About page — same shared AboutPage.astro template as
// src/pages/about.astro, own independently-written Arabic copy (not a
// translation of the English) — see docs/DECISIONS.md ADR-023.
import Layout from '../../layouts/Layout.astro';
import AboutPage from '../../components/AboutPage.astro';

const title = 'محمد الجابري — نبذة';
const description =
	'محمد الجابري أخصائي تصنيع إضافي بخبرة تتجاوز ست سنوات في الإنتاج والتدريب والهندسة داخل عُمان — المسيرة المهنية والخبرات التقنية والشهادات.';
const siteUrl = Astro.site?.toString() ?? 'https://mohdbsaid.com';
const email = 'mohdbsaid@outlook.com';
const whatsapp = 'https://wa.me/96891899818';

const jsonLd = [
	{
		'@type': 'Person',
		name: 'محمد الجابري',
		url: `${siteUrl}/ar/about`,
		description,
		jobTitle: 'أخصائي التصنيع الإضافي والطباعة ثلاثية الأبعاد',
		email: `mailto:${email}`,
		knowsAbout: [
			'التصنيع الإضافي',
			'الطباعة بتقنية FDM',
			'صيانة الطابعات',
			'تصميم CAD',
			'التدريب التقني',
			'الروبوتات',
			'إنترنت الأشياء',
		],
		alumniOf: {
			'@type': 'CollegeOrUniversity',
			name: 'كلية التقنية والعلوم التطبيقية (UTAS)، عُمان',
		},
	},
	{
		'@type': 'WebSite',
		name: 'محمد الجابري',
		url: `${siteUrl}/ar/about`,
		inLanguage: 'ar',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="ar"
	htmlDir="rtl"
	hideChrome
	skipLinkLabel="تخطَّ إلى المحتوى الرئيسي"
	locale="ar_OM"
>
	<Fragment slot="head">
		<link rel="alternate" hreflang="ar" href={new URL('/ar/about', siteUrl)} />
		<link rel="alternate" hreflang="en" href={new URL('/about', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/about', siteUrl)} />
	</Fragment>

	<AboutPage
		dir="rtl"
		email={email}
		whatsapp={whatsapp}
		nav={{
			logo: { label: 'محمد الجابري', href: '/ar' },
			links: [
				{ label: 'الأعمال', href: '/ar#work' },
				{ label: 'نبذة', href: '/ar/about' },
				{ label: 'تواصل', href: '#contact' },
			],
		}}
		hero={{
			name: 'محمد الجابري',
			initials: 'م ج',
			role: 'أخصائي التصنيع الإضافي والطباعة ثلاثية الأبعاد',
