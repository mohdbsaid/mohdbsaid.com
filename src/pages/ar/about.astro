---
// Arabic/RTL About page — same shared AboutPage.astro template as
// src/pages/about.astro, own independently-written Arabic copy (not a
// translation of the English) — see docs/DECISIONS.md ADR-023. Section
// copy comes from src/content/pages/about/**/ar.mdx, per the content-first
// architecture refactor (docs/DECISIONS.md ADR-024).
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AboutPage from '../../components/AboutPage.astro';
import { getPageSection } from '../../lib/content';
import { site } from '../../data/site';
import type { IconName } from '../../components/Icon.astro';

const locale = 'ar';

const [
	hero,
	profile,
	achievements,
	experience,
	industries,
	skills,
	training,
	certifications,
	philosophy,
	timeline,
	contact,
] = await Promise.all([
	getPageSection('about', 'hero', locale, 'hero'),
	getPageSection('about', 'profile', locale, 'prose'),
	getPageSection('about', 'achievements', locale, 'achievements'),
	getPageSection('about', 'experience', locale, 'experience'),
	getPageSection('about', 'industries', locale, 'industries'),
	getPageSection('about', 'skills', locale, 'skills'),
	getPageSection('about', 'training', locale, 'prose'),
	getPageSection('about', 'certifications', locale, 'certifications'),
	getPageSection('about', 'philosophy', locale, 'prose'),
	getPageSection('about', 'timeline', locale, 'timeline'),
	getPageSection('about', 'contact', locale, 'contact'),
]);

const [
	{ Content: ProfileContent },
	{ Content: TrainingContent },
	{ Content: PhilosophyContent },
	{ Content: ContactContent },
] = await Promise.all([render(profile), render(training), render(philosophy), render(contact)]);

const title = `${site.name.ar} — نبذة`;
const description = `${site.name.ar} أخصائي تصنيع إضافي بخبرة تتجاوز ست سنوات في الإنتاج والتدريب والهندسة داخل عُمان — المسيرة المهنية والخبرات التقنية والشهادات.`;
const siteUrl = Astro.site?.toString() ?? site.website;

const jsonLd = [
	{
		'@type': 'Person',
		name: site.name.ar,
		url: `${siteUrl}/ar/about`,
		description,
		jobTitle: site.title.ar,
		email: `mailto:${site.email}`,
		knowsAbout: [
			'التصنيع الإضافي',
			'الطباعة بتقنية FDM',
			'صيانة الطابعات',
			'تصميم CAD',
			'التدريب التقني',
			'الروبوتات',
			'إنترنت الأشياء',
		],
		alumniOf: {
			'@type': 'CollegeOrUniversity',
			name: certifications.data.institution,
		},
	},
	{
		'@type': 'WebSite',
		name: site.name.ar,
		url: `${siteUrl}/ar/about`,
		inLanguage: 'ar',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="ar"
	htmlDir="rtl"
	hideChrome
	skipLinkLabel="تخطَّ إلى المحتوى الرئيسي"
	locale="ar_OM"
>
	<Fragment slot="head">
		<link rel="alternate" hreflang="ar" href={new URL('/ar/about', siteUrl)} />
		<link rel="alternate" hreflang="en" href={new URL('/about', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/about', siteUrl)} />
	</Fragment>

	<AboutPage
		dir="rtl"
		email={site.email}
		whatsapp={site.whatsapp.url}
		whatsappDisplay={site.whatsapp.display}
		nav={{
			logo: { label: site.name.ar, href: '/ar' },
			links: [
				{ label: 'الأعمال', href: '/ar#work' },
				{ label: 'نبذة', href: '/ar/about' },
				{ label: 'تواصل', href: '#contact' },
			],
		}}
		hero={{
			name: site.name.ar,
			initials: site.initials.ar,
			role: site.title.ar,
			tagline: hero.data.tagline,
			emailLabel: hero.data.emailLabel,
			whatsappLabel: hero.data.whatsappLabel,
		}}
		profile={{
			eyebrow: profile.data.eyebrow,
			heading: profile.data.heading,
			Content: ProfileContent,
		}}
		achievements={achievements.data}
		experience={experience.data}
		industries={industries.data}
		expertise={{
			eyebrow: skills.data.eyebrow,
			heading: skills.data.heading,
			categories: skills.data.categories.map((category) => ({
				...category,
				icon: category.icon as IconName,
			})),
			note: skills.data.note,
		}}
		training={{
			eyebrow: training.data.eyebrow,
			heading: training.data.heading,
			Content: TrainingContent,
		}}
		education={certifications.data}
		philosophy={{
			eyebrow: philosophy.data.eyebrow,
			heading: philosophy.data.heading,
			Content: PhilosophyContent,
		}}
		timeline={timeline.data}
		contact={{
			eyebrow: contact.data.eyebrow,
			heading: contact.data.heading,
			Content: ContactContent,
		}}
		footer={`© ${new Date().getFullYear()} ${site.name.ar}`}
	/>
</Layout>
