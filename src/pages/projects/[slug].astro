---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import CardGrid from '../../components/CardGrid.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { formatArabicDate } from '../../utils/formatDate';
import { getRelatedProjects } from '../../lib/content';
import { site } from '../../data/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
	title,
	description,
	category,
	publishDate,
	status,
	client,
	year,
	technologies,
	gallery,
	cover,
	coverAlt,
	links,
} = project.data;

const { Content } = await render(project);
const relatedProjects = await getRelatedProjects(project);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
	'@type': 'CreativeWork',
	name: title,
	description,
	url: canonicalUrl,
	dateCreated: publishDate.toISOString(),
	datePublished: publishDate.toISOString(),
	...(cover && { image: new URL(cover.src, Astro.site).toString() }),
	...(technologies && technologies.length > 0 && { keywords: technologies.join('، ') }),
	...(client && { sourceOrganization: { '@type': 'Organization', name: client } }),
	author: { '@type': 'Person', name: site.name.ar },
};
---

<PageLayout
	title={title}
	description={description}
	eyebrow={category}
	image={cover?.src}
	imageAlt={coverAlt}
	jsonLd={jsonLd}
>
	<a class="back-link" href="/projects">→ العودة إلى المشاريع</a>

	{
		cover && (
			<Image
				class="cover"
				src={cover}
				alt={coverAlt ?? ''}
				widths={[600, 1100]}
				sizes="(max-width: 800px) 100vw, 1100px"
				width={1100}
				height={619}
			/>
		)
	}

	<dl class="meta-list">
		<div>
			<dt>الفئة</dt>
			<dd>{category}</dd>
		</div>
		{
			status && (
				<div>
					<dt>الحالة</dt>
					<dd>{status}</dd>
				</div>
			)
		}
		{
			client && (
				<div>
					<dt>العميل</dt>
					<dd>{client}</dd>
				</div>
			)
		}
		<div>
			<dt>{year ? 'السنة' : 'تاريخ النشر'}</dt>
			<dd>{year ?? formatArabicDate(publishDate)}</dd>
		</div>
		{
			technologies && technologies.length > 0 && (
				<div>
					<dt>الأدوات والتقنيات</dt>
					<dd>{technologies.join('، ')}</dd>
				</div>
			)
		}
	</dl>

	{
		(links?.github || links?.demo) && (
			<div class="links-row">
				{links.github && (
					<Button href={links.github} variant="secondary">
						الكود المصدري
					</Button>
				)}
				{links.demo && <Button href={links.demo}>تجربة حية</Button>}
			</div>
		)
	}

	<div class="project-body">
		<Content />
	</div>

	{
		gallery && gallery.length > 0 && (
			<div id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
				<SectionHeading id="gallery-heading" title="معرض الصور" />
				<div class="gallery-grid">
					{gallery.map((item, index) => (
						<Image
							src={item.image}
							alt={item.alt}
							widths={[400, 700]}
							sizes="(max-width: 800px) 50vw, 350px"
							width={700}
							height={525}
							loading={index < 2 ? 'eager' : 'lazy'}
						/>
					))}
				</div>
			</div>
		)
	}

	{
		relatedProjects.length > 0 && (
			<div id="related-projects" aria-labelledby="related-projects-heading" class="related-section">
				<SectionHeading id="related-projects-heading" title="مشاريع ذات صلة" />
				<CardGrid
					items={relatedProjects.map((related) => ({
						kind: 'مشروع',
						title: related.data.title,
						description: related.data.description,
						meta: `${related.data.category} · ${formatArabicDate(related.data.publishDate)}`,
						href: `/projects/${related.id}`,
						image: related.data.cover,
						imageAlt: related.data.coverAlt,
					}))}
				/>
			</div>
		)
	}
</PageLayout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: var(--space-3);
		color: var(--color-primary);
		font-weight: 700;
	}

	.cover {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-medium);
		margin-bottom: var(--space-4);
	}

	.meta-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin: 0 0 var(--space-4);
		padding: var(--space-3);
		background: var(--color-surface);
		border-radius: var(--radius-medium);
	}

	.meta-list dt {
		margin: 0 0 0.25rem;
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.meta-list dd {
		margin-inline-start: 0;
		font-size: 0.95rem;
	}

	.links-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}

	.project-body {
		max-width: 46rem;
	}

	.project-body :global(h2) {
		margin: var(--space-5) 0 var(--space-2);
		font-size: 1.3rem;
		line-height: 1.4;
	}

	.project-body :global(h2:first-child) {
		margin-top: 0;
	}

	.project-body :global(p) {
		margin: 0 0 var(--space-2);
		color: var(--color-text);
		line-height: 1.8;
	}

	.gallery-section,
	.related-section {
		margin-top: var(--space-6);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-2);
	}

	.gallery-grid img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-small);
	}

	@media (max-width: 800px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
