---
// English/LTR About page — the primary professional profile, sharing the
// homepage's exact visual identity via the shared AboutPage.astro template
// (see docs/DECISIONS.md ADR-023). Replaces the previous Arabic-only,
// light-themed about.astro; that content has moved to /ar/about, rewritten
// rather than carried over — see the ADR for why.
//
// Every fact below traces to the project owner's CV (confirmed as
// Mohammed_Aljabri_CV_2026.docx) — no invented achievements, numbers,
// dates, employers, or certifications.
import Layout from '../layouts/Layout.astro';
import AboutPage from '../components/AboutPage.astro';

const title = 'Mohammed Al-Jabri — About';
const description =
	'Mohammed Al-Jabri is an additive manufacturing specialist with 6+ years of production, training, and engineering experience in Oman — career background, technical expertise, and credentials.';
const siteUrl = Astro.site?.toString() ?? 'https://mohdbsaid.com';
const email = 'mohdbsaid@outlook.com';
const whatsapp = 'https://wa.me/96891899818';

const jsonLd = [
	{
		'@type': 'Person',
		name: 'Mohammed Al-Jabri',
		url: `${siteUrl}/about`,
		description,
		jobTitle: 'Additive Manufacturing & 3D Printing Specialist',
		email: `mailto:${email}`,
		knowsAbout: [
			'Additive Manufacturing',
			'FDM 3D Printing',
			'Printer Maintenance',
			'CAD Workflow',
			'Technical Training',
			'Robotics',
			'IoT',
		],
		alumniOf: {
			'@type': 'CollegeOrUniversity',
			name: 'University of Technology and Applied Sciences (UTAS), Oman',
		},
	},
	{
		'@type': 'WebSite',
		name: 'Mohammed Al-Jabri',
		url: `${siteUrl}/about`,
		inLanguage: 'en',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="en"
	htmlDir="ltr"
	hideChrome
	skipLinkLabel="Skip to main content"
	locale="en_US"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" hreflang="en" href={new URL('/about', siteUrl)} />
		<link rel="alternate" hreflang="ar" href={new URL('/ar/about', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/about', siteUrl)} />
	</Fragment>

	<AboutPage
		dir="ltr"
		email={email}
		whatsapp={whatsapp}
		nav={{
			logo: { label: 'Mohammed Al-Jabri', href: '/' },
			links: [
				{ label: 'Work', href: '/#work' },
				{ label: 'About', href: '/about' },
				{ label: 'Contact', href: '#contact' },
			],
		}}
		hero={{
			name: 'Mohammed Al-Jabri',
			initials: 'MA',
			role: 'Additive Manufacturing & 3D Printing Specialist',
			tagline:
				'Six years of hands-on FDM production, technical training, and engineering work across Oman — the full background behind the homepage.',
			emailLabel: 'Email',
			whatsappLabel: 'WhatsApp',
		}}
		profile={{
			eyebrow: 'Profile',
			heading: 'Profile',
			paragraphs: [
				'My path into additive manufacturing started with a diploma in communications and electronics engineering — a foundation that still shapes how I approach every failed print: as a signal to trace back to its source, not a problem to route around. Over six years, that habit turned into a specialty — keeping FDM production lines dependable for government, energy, and industrial clients across Oman, through calibration, root-cause diagnostics, and workflow optimization that holds up under real production pressure, not just in a controlled test print.',
				"Alongside that production work, I've spent a significant part of my career on the training side of the field — designing and delivering workshops that have reached more than 1,300 people across every governorate in Oman, and contributing to the development and commercialization of a locally built 3D printer. Both threads come from the same instinct: additive manufacturing in Oman is still young, and the more people who understand it properly, the better it gets for everyone working in it.",
			],
		}}
		achievements={{
			eyebrow: 'Achievements',
			heading: 'Core Achievements',
			stats: [
				{ value: 6, suffix: '+', label: 'Years of Experience' },
				{ value: 32, suffix: '+', label: 'Projects' },
				{ value: 63, suffix: '', label: 'Workshops' },
				{ value: 1340, suffix: '+', label: 'Participants' },
			],
		}}
		experience={{
			eyebrow: 'Experience',
			heading: 'Professional Experience',
			roles: [
				{
					title: '3D Printing Specialist',
					company: 'Plamore Manufacture',
					period: 'Dec 2024 – Jan 2026',
					description:
						'Operated and maintained professional FDM systems for production work serving government and industrial clients — job preparation, material selection, slicing parameters, production monitoring, and final quality inspection. Ran calibration and preventive maintenance to improve equipment reliability, and diagnosed mechanical, electrical, and process-related failures through root-cause analysis rather than trial and error.',
				},
				{
					title: '3D Printing Technician',
					company: '3D Factory',
					period: 'Sep 2020 – Nov 2024',
					description:
						'Prepared and optimized print jobs using CAD and slicing tools, balancing dimensional accuracy, surface quality, material use, and production time. Delivered prototypes, educational models, and customized parts for industrial and institutional clients across Oman, while advising teams on materials, print orientation, and support strategy.',
				},
			],
		}}
		industries={{
			eyebrow: 'Industries',
			heading: 'Industries & Clients',
			groups: [
				{
					title: 'Government & Defense',
					items: ['Ministry of Defence', 'Civil Aviation Authority'],
				},
				{ title: 'Energy', items: ['PDO', 'OQGN', 'SLB'] },
				{ title: 'Industrial Manufacturing', items: ['Jindal Steel Oman'] },
				{ title: 'Urban Development', items: ['Sultan Haitham City'] },
			],
		}}
		expertise={{
			eyebrow: 'Expertise',
			heading: 'Technical Expertise',
			categories: [
				{
					icon: 'print',
					title: 'Additive Manufacturing',
					skills:
						'FDM systems, print preparation, slicing, parameter optimization, material selection, prototype production, quality inspection, post-processing.',
				},
				{
					icon: 'wrench',
					title: 'Maintenance & Engineering',
					skills:
						'Calibration, preventive maintenance, mechanical assembly, electronics maintenance, troubleshooting, root-cause analysis, operational safety.',
				},
				{
					icon: 'code',
					title: 'Software & Tools',
					skills:
						'Fusion 360, OrcaSlicer, CAD fundamentals, STL/3MF preparation, print workflow management.',
				},
				{
					icon: 'book',
					title: 'Training & Documentation',
					skills:
						'Workshop design and delivery, technical instruction, training materials, SOPs, technical documentation.',
				},
			],
			note: 'Also exploring robotics and IoT applications as a natural extension of this work.',
		}}
		training={{
			eyebrow: 'Training',
			heading: 'Training',
			paragraph:
				"Independent of any single employer, I've spent years designing and delivering training on additive manufacturing fundamentals — printer operation, maintenance, safety, slicing, and practical applications — for teachers, students, and industry professionals across Oman. Some of that work has been with schools and universities adopting 3D printing as part of hands-on STEM learning; some with professionals looking to bring the skill in-house. Every session is shaped around where the audience actually is, not a fixed curriculum.",
		}}
		education={{
			eyebrow: 'Education',
			heading: 'Education & Certifications',
			degree: 'Diploma in Communications & Electronics Engineering',
			institution: 'University of Technology and Applied Sciences (UTAS), Oman',
			period: '2020',
			coursework:
				'Relevant coursework: Analog Electronics, Digital Electronics, Electrical Safety, Maintenance and Repair.',
			certificationsLabel: 'Certifications',
			certifications: [
				'Professional Design Engineer',
				'Additive Manufacturing: Materials for 3D Printing',
				'Robotics and Artificial Intelligence',
				'Health, Safety and Environment (HSE)',
				'Internet of Things (IoT)',
				'Training of Trainers (ToT)',
			],
		}}
		philosophy={{
			eyebrow: 'Philosophy',
			heading: 'Engineering Philosophy',
			paragraph:
				"Good additive manufacturing work is mostly invisible — a part that prints right the first time, a machine that doesn't go down mid-run, a workshop attendee who leaves able to fix their own printer instead of needing to call someone. I'd rather spend an extra ten minutes finding why a print actually failed than spend an hour reprinting it and hoping. That habit is slower in the moment and faster over a career.",
		}}
		timeline={{
			eyebrow: 'Timeline',
			heading: 'Timeline',
			items: [
				{ period: '2020', title: 'Diploma in Communications & Electronics Engineering, UTAS' },
				{ period: '2020 – 2024', title: '3D Printing Technician, 3D Factory' },
				{ period: '2024 – 2026', title: '3D Printing Specialist, Plamore Manufacture' },
			],
		}}
		contact={{
			eyebrow: 'Contact',
			heading: 'Let’s work together',
			paragraph:
				'Open to conversations about additive manufacturing, technical training, or your next production challenge — reach out by email or WhatsApp.',
			whatsappDisplay: '+968 91899818',
		}}
		footer={`© ${new Date().getFullYear()} Mohammed Al-Jabri`}
	/>
</Layout>
