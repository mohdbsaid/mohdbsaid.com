---
// English/LTR About page — the primary professional profile, sharing the
// homepage's exact visual identity via the shared AboutPage.astro template
// (see docs/DECISIONS.md ADR-023). All section copy is fetched from
// src/content/pages/about/**/en.mdx (content-first architecture — see
// docs/DECISIONS.md ADR-024) instead of being hardcoded here; global facts
// (name, email, WhatsApp) come from src/data/site.ts.
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AboutPage from '../components/AboutPage.astro';
import { getPageSection } from '../lib/content';
import { site } from '../data/site';
import type { IconName } from '../components/Icon.astro';

const locale = 'en';

const [
	hero,
	profile,
	achievements,
	experience,
	industries,
	skills,
	training,
	certifications,
	philosophy,
	timeline,
	contact,
] = await Promise.all([
	getPageSection('about', 'hero', locale, 'hero'),
	getPageSection('about', 'profile', locale, 'prose'),
	getPageSection('about', 'achievements', locale, 'achievements'),
	getPageSection('about', 'experience', locale, 'experience'),
	getPageSection('about', 'industries', locale, 'industries'),
	getPageSection('about', 'skills', locale, 'skills'),
	getPageSection('about', 'training', locale, 'prose'),
	getPageSection('about', 'certifications', locale, 'certifications'),
	getPageSection('about', 'philosophy', locale, 'prose'),
	getPageSection('about', 'timeline', locale, 'timeline'),
	getPageSection('about', 'contact', locale, 'contact'),
]);

const [
	{ Content: ProfileContent },
	{ Content: TrainingContent },
	{ Content: PhilosophyContent },
	{ Content: ContactContent },
] = await Promise.all([render(profile), render(training), render(philosophy), render(contact)]);

const title = `${site.name.en} — About`;
const description = `${site.name.en} is an additive manufacturing specialist with 6+ years of production, training, and engineering experience in Oman — career background, technical expertise, and credentials.`;
const siteUrl = Astro.site?.toString() ?? site.website;

const jsonLd = [
	{
		'@type': 'Person',
		name: site.name.en,
		url: `${siteUrl}/about`,
		description,
		jobTitle: site.title.en,
		email: `mailto:${site.email}`,
		knowsAbout: [
			'Additive Manufacturing',
			'FDM 3D Printing',
			'Printer Maintenance',
			'CAD Workflow',
			'Technical Training',
			'Robotics',
			'IoT',
		],
		alumniOf: {
			'@type': 'CollegeOrUniversity',
			name: certifications.data.institution,
		},
	},
	{
		'@type': 'WebSite',
		name: site.name.en,
		url: `${siteUrl}/about`,
		inLanguage: 'en',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="en"
	htmlDir="ltr"
	hideChrome
	skipLinkLabel="Skip to main content"
	locale="en_US"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" hreflang="en" href={new URL('/about', siteUrl)} />
		<link rel="alternate" hreflang="ar" href={new URL('/ar/about', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/about', siteUrl)} />
	</Fragment>

	<AboutPage
		dir="ltr"
		email={site.email}
		whatsapp={site.whatsapp.url}
		whatsappDisplay={site.whatsapp.display}
		nav={{
			logo: { label: site.name.en, href: '/' },
			links: [
				{ label: 'Work', href: '/#work' },
				{ label: 'About', href: '/about' },
				{ label: 'Contact', href: '#contact' },
			],
		}}
		hero={{
			name: site.name.en,
			initials: site.initials.en,
			role: site.title.en,
			tagline: hero.data.tagline,
			emailLabel: hero.data.emailLabel,
			whatsappLabel: hero.data.whatsappLabel,
		}}
		profile={{
			eyebrow: profile.data.eyebrow,
			heading: profile.data.heading,
			Content: ProfileContent,
		}}
		achievements={achievements.data}
		experience={experience.data}
		industries={industries.data}
		expertise={{
			eyebrow: skills.data.eyebrow,
			heading: skills.data.heading,
			categories: skills.data.categories.map((category) => ({
				...category,
				icon: category.icon as IconName,
			})),
			note: skills.data.note,
		}}
		training={{
			eyebrow: training.data.eyebrow,
			heading: training.data.heading,
			Content: TrainingContent,
		}}
		education={certifications.data}
		philosophy={{
			eyebrow: philosophy.data.eyebrow,
			heading: philosophy.data.heading,
			Content: PhilosophyContent,
		}}
		timeline={timeline.data}
		contact={{
			eyebrow: contact.data.eyebrow,
			heading: contact.data.heading,
			Content: ContactContent,
		}}
		footer={`© ${new Date().getFullYear()} ${site.name.en}`}
	/>
</Layout>
