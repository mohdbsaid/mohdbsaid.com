---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import CardGrid from '../../../components/CardGrid.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { formatArabicDate } from '../../../utils/formatDate';
import type { BreadcrumbItem } from '../../../types';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;

posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const title = `الوسم: ${tag}`;
const description = `مقالات موسومة بـ «${tag}».`;

const breadcrumbItems: BreadcrumbItem[] = [
	{ label: 'الرئيسية', href: '/ar' },
	{ label: 'المدونة', href: '/blog' },
	{ label: tag ?? '' },
];
---

<PageLayout title={title} description={description} eyebrow="المدونة">
	<Breadcrumbs items={breadcrumbItems} />

	<CardGrid
		items={posts.map((post) => ({
			kind: 'مقالة',
			title: post.data.title,
			description: post.data.description,
			meta: `${post.data.category} · ${formatArabicDate(post.data.publishDate)}`,
			href: `/blog/${post.id}`,
			image: post.data.cover,
			imageAlt: post.data.coverAlt,
		}))}
	/>
</PageLayout>
