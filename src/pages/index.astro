---
// English/LTR homepage — deliberately bypasses the site's global Arabic
// <Header>/<Footer> chrome (via Layout's hideChrome) and renders the shared
// <PersonalPortfolio> template instead. Intentionally minimal: hero,
// selected work, contact — the detailed professional profile lives on
// /about (see AboutPage.astro) — per docs/DECISIONS.md ADR-023. Section
// copy comes from src/content/pages/home/**/en.mdx (docs/DECISIONS.md ADR-024).
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PersonalPortfolio from '../components/PersonalPortfolio.astro';
import { selectedWork } from '../data/selectedWork';
import { getPageSection } from '../lib/content';
import { site } from '../data/site';

const locale = 'en';

const [hero, workIntro, contact] = await Promise.all([
	getPageSection('home', 'hero', locale, 'hero'),
	getPageSection('home', 'workintro', locale, 'workintro'),
	getPageSection('home', 'contact', locale, 'contact'),
]);

const { Content: ContactContent } = await render(contact);

const title = `${site.name.en} — ${site.title.en}`;
const description = `${site.name.en} is an additive manufacturing specialist based in Oman. Explore selected work or get in touch — full professional background on the About page.`;
const siteUrl = Astro.site?.toString() ?? site.website;

const jsonLd = [
	{
		'@type': 'Person',
		name: site.name.en,
		url: siteUrl,
		description,
		jobTitle: site.title.en,
		email: `mailto:${site.email}`,
	},
	{
		'@type': 'WebSite',
		name: site.name.en,
		url: siteUrl,
		inLanguage: 'en',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="en"
	htmlDir="ltr"
	hideChrome
	skipLinkLabel="Skip to main content"
	locale="en_US"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" hreflang="en" href={new URL('/', siteUrl)} />
		<link rel="alternate" hreflang="ar" href={new URL('/ar', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />
	</Fragment>

	<PersonalPortfolio
		dir="ltr"
		email={site.email}
		whatsapp={site.whatsapp.url}
		whatsappDisplay={site.whatsapp.display}
		nav={{
			logo: { label: site.name.en, href: '/' },
			links: [
				{ label: 'Work', href: '#work' },
				{ label: 'About', href: '/about' },
				{ label: 'Contact', href: '#contact' },
			],
		}}
		hero={{
			name: site.name.en,
			initials: site.initials.en,
			role: site.title.en,
			intro: hero.data.tagline,
			emailLabel: hero.data.emailLabel,
			whatsappLabel: hero.data.whatsappLabel,
		}}
		work={{
			eyebrow: workIntro.data.eyebrow,
			heading: workIntro.data.heading,
			projects: selectedWork.map((item) => ({ icon: item.icon, ...item.en })),
		}}
		contact={{
			eyebrow: contact.data.eyebrow,
			heading: contact.data.heading,
			Content: ContactContent,
		}}
		footer={`© ${new Date().getFullYear()} ${site.name.en}`}
	/>
</Layout>
