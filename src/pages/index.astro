---
// English/LTR homepage — deliberately bypasses the site's global Arabic
// <Header>/<Footer> chrome (via Layout's hideChrome) and renders the shared
// <PersonalPortfolio> template instead. Intentionally minimal: hero,
// selected work, contact — the detailed professional profile lives on
// /about (see AboutPage.astro) — per docs/DECISIONS.md ADR-023.
import Layout from '../layouts/Layout.astro';
import PersonalPortfolio from '../components/PersonalPortfolio.astro';
import { selectedWork } from '../data/selectedWork';

const title = 'Mohammed Al-Jabri — Additive Manufacturing & 3D Printing Specialist';
const description =
	'Mohammed Al-Jabri is an additive manufacturing specialist based in Oman. Explore selected work or get in touch — full professional background on the About page.';
const siteUrl = Astro.site?.toString() ?? 'https://mohdbsaid.com';
const email = 'mohdbsaid@outlook.com';
const whatsapp = 'https://wa.me/96891899818';

const jsonLd = [
	{
		'@type': 'Person',
		name: 'Mohammed Al-Jabri',
		url: siteUrl,
		description,
		jobTitle: 'Additive Manufacturing & 3D Printing Specialist',
		email: `mailto:${email}`,
	},
	{
		'@type': 'WebSite',
		name: 'Mohammed Al-Jabri',
		url: siteUrl,
		inLanguage: 'en',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={jsonLd}
	fullBleed
	htmlLang="en"
	htmlDir="ltr"
	hideChrome
	skipLinkLabel="Skip to main content"
	locale="en_US"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" hreflang="en" href={new URL('/', siteUrl)} />
		<link rel="alternate" hreflang="ar" href={new URL('/ar', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />
	</Fragment>

	<PersonalPortfolio
		dir="ltr"
		email={email}
		whatsapp={whatsapp}
		nav={{
			logo: { label: 'Mohammed Al-Jabri', href: '/' },
			links: [
				{ label: 'Work', href: '#work' },
				{ label: 'About', href: '/about' },
				{ label: 'Contact', href: '#contact' },
			],
		}}
		hero={{
			name: 'Mohammed Al-Jabri',
			initials: 'MA',
			role: 'Additive Manufacturing & 3D Printing Specialist',
			intro:
				'I turn ideas into physical parts — through reliable FDM production, hands-on training, and six years of hard-won experience in Oman.',
			emailLabel: 'Email',
			whatsappLabel: 'WhatsApp',
		}}
		work={{
			eyebrow: 'Work',
			heading: 'Selected Work',
			projects: selectedWork.map((item) => ({ icon: item.icon, ...item.en })),
		}}
		contact={{
			eyebrow: 'Contact',
			heading: 'Let’s work together',
			paragraph:
				'Open to conversations about additive manufacturing, technical training, or your next production challenge — reach out by email or WhatsApp.',
			whatsappDisplay: '+968 91899818',
		}}
		footer={`© ${new Date().getFullYear()} Mohammed Al-Jabri`}
	/>
</Layout>
