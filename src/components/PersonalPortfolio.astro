---
// Homepage content — intentionally minimal: it answers three questions
// (who, what, how to contact) and nothing else. Detailed professional
// content (experience, achievements, industries, credentials) lives on
// /about — see AboutPage.astro and docs/DECISIONS.md ADR-023.
//
// Shared chrome (nav, footer, contact CTA, design tokens/CSS, scroll
// behavior) comes from GlassNav/GlassFooter/GlassContactCTA +
// src/styles/glass-theme.css + src/lib/glassInteractions.ts — the same
// pieces AboutPage.astro uses, so the two pages can't visually drift apart
// from each other over time.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import '../styles/glass-theme.css';
import Icon, { type IconName } from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import GlassNav from './GlassNav.astro';
import GlassFooter from './GlassFooter.astro';
import GlassContactCTA from './GlassContactCTA.astro';

interface NavLink {
	label: string;
	href: string;
}

interface ProjectContent {
	icon: IconName;
	title: string;
	description: string;
	category: string;
	status: string;
}

interface Props {
	dir: 'ltr' | 'rtl';
	nav: { logo: NavLink; links: NavLink[] };
	hero: {
		name: string;
		initials: string;
		role: string;
		intro: string;
		emailLabel: string;
		whatsappLabel: string;
	};
	work: { eyebrow: string; heading: string; projects: ProjectContent[] };
	contact: { eyebrow: string; heading: string; Content: AstroComponentFactory };
	footer: string;
	email: string;
	whatsapp: string;
	whatsappDisplay: string;
}

const { dir, nav, hero, work, contact, footer, email, whatsapp, whatsappDisplay } = Astro.props;
const isRtl = dir === 'rtl';
const fontFamily = isRtl
	? "'Thmanyah Sans', system-ui, sans-serif"
	: "'Inter', system-ui, sans-serif";
---

<div
	class="page-bg"
	dir={dir}
	style={`--font-family: ${fontFamily}; --hero-mark-size: clamp(6rem, 9vw, 7.5rem); --hero-mark-font-size: clamp(1.75rem, 2.5vw, 2.25rem);`}
>
	<GlassNav logo={nav.logo} links={nav.links} dir={dir} />

	<section class="hero" aria-label="Introduction">
		<div class="hero-inner">
			<div class="hero-content">
				<h1>{hero.name}</h1>
				<p class="hero-role">
					<Icon name="print" class="hero-role-icon" />
					{hero.role}
				</p>
				<p class="hero-copy">{hero.intro}</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href={`mailto:${email}`}>
						<Icon name="mail" />
						{hero.emailLabel}
					</a>
					<a class="btn btn-secondary" href={whatsapp} target="_blank" rel="noopener noreferrer">
						<Icon name="message" />
						{hero.whatsappLabel}
					</a>
				</div>
			</div>
			<div class="hero-mark" aria-hidden="true"><span>{hero.initials}</span></div>
		</div>
	</section>

	<section id="work" aria-labelledby="work-heading" class="section reveal">
		<p class="eyebrow">{work.eyebrow}</p>
		<h2 id="work-heading">{work.heading}</h2>

		<div class="project-grid">
			{
				work.projects.map((item) => (
					<ProjectCard
						title={item.title}
						description={item.description}
						status={item.status}
						category={item.category}
						icon={item.icon}
					/>
				))
			}
		</div>
	</section>

	<GlassContactCTA
		eyebrow={contact.eyebrow}
		heading={contact.heading}
		Content={contact.Content}
		email={email}
		whatsapp={whatsapp}
		whatsappDisplay={whatsappDisplay}
	/>

	<GlassFooter text={footer} />
</div>

<style>
	/* ---------- Hero ---------- */
	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(2.5rem, 6vw, 5rem);
		padding-block: clamp(4rem, 10vw, 7.5rem) clamp(4.5rem, 10vw, 8rem);
	}

	.hero-content {
		flex: 1 1 34rem;
		max-width: 40rem;
	}

	.hero-content h1 {
		font-size: clamp(2.75rem, 2.1rem + 3vw, 4.25rem);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.025em;
		background: linear-gradient(135deg, #ffffff, var(--accent-soft));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 1.25rem;
	}

	.hero-role {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		color: var(--accent-soft);
		font-weight: 500;
		line-height: 1.5;
		margin-bottom: 1.5rem;
	}

	.hero-role :global(.hero-role-icon) {
		width: 1.15em;
		height: 1.15em;
		color: var(--accent);
		flex-shrink: 0;
	}

	.hero-copy {
		font-size: 1.0625rem;
		line-height: 1.85;
		color: var(--ink-muted);
		max-width: 32rem;
		margin-bottom: 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	/* .hero-mark is shared — see src/styles/glass-theme.css */

	/* ---------- Project grid ---------- */
	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		align-items: stretch;
	}

	@media (max-width: 900px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.hero-inner {
			flex-direction: column-reverse;
			text-align: center;
			gap: 2rem;
		}
		.hero-content {
			max-width: none;
		}
		.hero-copy {
			margin-inline: auto;
		}
		.hero-role,
		.hero-actions {
			justify-content: center;
		}
	}

	@media (max-width: 640px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { initGlassInteractions } from '../lib/glassInteractions';
	initGlassInteractions();
</script>
