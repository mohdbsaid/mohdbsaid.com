---
// The primary professional profile — the detailed content that used to
// live on the homepage moved here (see docs/DECISIONS.md ADR-023). Shares
// its entire visual identity with the homepage via GlassNav/GlassFooter/
// GlassContactCTA + src/styles/glass-theme.css + src/lib/glassInteractions.ts
// — same tokens, same components, same motion, not a second design.
import '../styles/glass-theme.css';
import Icon, { type IconName } from './Icon.astro';
import GlassNav from './GlassNav.astro';
import GlassFooter from './GlassFooter.astro';
import GlassContactCTA from './GlassContactCTA.astro';

interface NavLink {
	label: string;
	href: string;
}

interface StatContent {
	value: number;
	suffix: string;
	label: string;
}

interface RoleContent {
	title: string;
	company: string;
	period: string;
	description: string;
}

interface IndustryGroup {
	title: string;
	items: string[];
}

interface SkillCategory {
	icon: IconName;
	title: string;
	skills: string;
}

interface TimelineItem {
	period: string;
	title: string;
}

interface Props {
	dir: 'ltr' | 'rtl';
	nav: { logo: NavLink; links: NavLink[] };
	hero: {
		name: string;
		initials: string;
		role: string;
		tagline: string;
		emailLabel: string;
		whatsappLabel: string;
	};
	profile: { eyebrow: string; heading: string; paragraphs: string[] };
	achievements: { eyebrow: string; heading: string; stats: StatContent[] };
	experience: { eyebrow: string; heading: string; roles: RoleContent[] };
	industries: { eyebrow: string; heading: string; groups: IndustryGroup[] };
	expertise: { eyebrow: string; heading: string; categories: SkillCategory[]; note: string };
	training: { eyebrow: string; heading: string; paragraph: string };
	education: {
		eyebrow: string;
		heading: string;
		degree: string;
		institution: string;
		period: string;
		coursework: string;
		certificationsLabel: string;
		certifications: string[];
	};
	philosophy: { eyebrow: string; heading: string; paragraph: string };
	timeline: { eyebrow: string; heading: string; items: TimelineItem[] };
	contact: { eyebrow: string; heading: string; paragraph: string; whatsappDisplay: string };
	footer: string;
	email: string;
	whatsapp: string;
}

const {
	dir,
	nav,
	hero,
	profile,
	achievements,
	experience,
	industries,
	expertise,
	training,
	education,
	philosophy,
	timeline,
	contact,
	footer,
	email,
	whatsapp,
} = Astro.props;

const isRtl = dir === 'rtl';
const fontFamily = isRtl
	? "'Thmanyah Sans', system-ui, sans-serif"
	: "'Inter', system-ui, sans-serif";

// Built here (not as adjacent JSX children) so there's no risk of a
// formatter's line-wrapping collapsing the whitespace between them — see
// docs/DECISIONS.md ADR-023 for the bug this already caused once this
// session with a multi-line <strong> tag.
const educationMeta = `${education.institution} · ${education.period}`;
---

<div class="page-bg" dir={dir} style={`--font-family: ${fontFamily};`}>
	<GlassNav logo={nav.logo} links={nav.links} />

	<section class="hero" aria-label="Introduction">
		<div class="hero-inner">
			<div class="hero-content">
				<h1>{hero.name}</h1>
				<p class="hero-role">
					<Icon name="print" class="hero-role-icon" />
					{hero.role}
				</p>
				<p class="hero-copy">{hero.tagline}</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href={`mailto:${email}`}>
						<Icon name="mail" />
						{hero.emailLabel}
					</a>
					<a class="btn btn-secondary" href={whatsapp} target="_blank" rel="noopener noreferrer">
						<Icon name="message" />
						{hero.whatsappLabel}
					</a>
				</div>
			</div>
			<div class="hero-mark" aria-hidden="true"><span>{hero.initials}</span></div>
		</div>
	</section>

	<section id="profile" aria-labelledby="profile-heading" class="section reveal">
		<p class="eyebrow">{profile.eyebrow}</p>
		<h2 id="profile-heading">{profile.heading}</h2>
		<div class="profile-text">
			{profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section id="achievements" aria-labelledby="achievements-heading" class="section reveal">
		<p class="eyebrow">{achievements.eyebrow}</p>
		<h2 id="achievements-heading">{achievements.heading}</h2>
		<div class="stat-band">
			{
				achievements.stats.map((stat) => (
					<div class="stat-item">
						<div class="stat-number" data-count={stat.value} data-suffix={stat.suffix}>
							0
						</div>
						<div class="stat-label">{stat.label}</div>
					</div>
				))
			}
		</div>
	</section>

	<section id="experience" aria-labelledby="experience-heading" class="section reveal">
		<p class="eyebrow">{experience.eyebrow}</p>
		<h2 id="experience-heading">{experience.heading}</h2>

		<div class="experience-list">
			{
				experience.roles.map((role) => (
					<div class="experience-item">
						<div class="experience-head">
							<div class="experience-role">
								<span class="experience-title">{role.title}</span>
								<span class="experience-dash" aria-hidden="true">
									—
								</span>
								<span class="experience-company">{role.company}</span>
							</div>
							<span class="experience-period">{role.period}</span>
						</div>
						<p class="experience-description">{role.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section id="industries" aria-labelledby="industries-heading" class="section reveal">
		<p class="eyebrow">{industries.eyebrow}</p>
		<h2 id="industries-heading">{industries.heading}</h2>

		<div class="industry-grid">
			{
				industries.groups.map((group) => (
					<div class="industry-card">
						<h3 class="industry-title">{group.title}</h3>
						<ul class="industry-tags">
							{group.items.map((item) => (
								<li class="industry-tag">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section id="expertise" aria-labelledby="expertise-heading" class="section reveal">
		<p class="eyebrow">{expertise.eyebrow}</p>
		<h2 id="expertise-heading">{expertise.heading}</h2>

		<div class="expertise-grid">
			{
				expertise.categories.map((category) => (
					<div class="expertise-card">
						<div class="expertise-icon">
							<Icon name={category.icon} />
						</div>
						<h3 class="expertise-title">{category.title}</h3>
						<p class="expertise-skills">{category.skills}</p>
					</div>
				))
			}
		</div>
		<p class="expertise-note">{expertise.note}</p>
	</section>

	<section id="training" aria-labelledby="training-heading" class="section reveal">
		<p class="eyebrow">{training.eyebrow}</p>
		<h2 id="training-heading">{training.heading}</h2>
		<p class="training-text">{training.paragraph}</p>
	</section>

	<section id="education" aria-labelledby="education-heading" class="section reveal">
		<p class="eyebrow">{education.eyebrow}</p>
		<h2 id="education-heading">{education.heading}</h2>

		<div class="education-grid">
			<div class="education-block">
				<p class="education-degree">{education.degree}</p>
				<p class="education-institution">{educationMeta}</p>
				<p class="education-coursework">{education.coursework}</p>
			</div>
			<div class="certifications-block">
				<p class="certifications-label">{education.certificationsLabel}</p>
				<ul class="cert-list">
					{education.certifications.map((cert) => <li class="cert-badge">{cert}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section id="philosophy" aria-labelledby="philosophy-heading" class="section reveal">
		<p class="eyebrow">{philosophy.eyebrow}</p>
		<h2 id="philosophy-heading">{philosophy.heading}</h2>
		<p class="philosophy-text">{philosophy.paragraph}</p>
	</section>

	<section id="timeline" aria-labelledby="timeline-heading" class="section reveal">
		<p class="eyebrow">{timeline.eyebrow}</p>
		<h2 id="timeline-heading">{timeline.heading}</h2>

		<ol class="timeline-list">
			{
				timeline.items.map((item) => (
					<li class="timeline-item">
						<span class="timeline-period">
							<bdi>{item.period}</bdi>
						</span>
						<span class="timeline-title">{item.title}</span>
					</li>
				))
			}
		</ol>
	</section>

	<GlassContactCTA
		eyebrow={contact.eyebrow}
		heading={contact.heading}
		paragraph={contact.paragraph}
		email={email}
		whatsapp={whatsapp}
		whatsappDisplay={contact.whatsappDisplay}
	/>

	<GlassFooter text={footer} />
</div>

<style>
	/* ---------- Hero (About's hero is a shorter intro block, not the
	   full-height homepage hero — this page has a lot more to scroll
	   through below it) ---------- */
	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(2.5rem, 6vw, 5rem);
		padding-block: clamp(3rem, 7vw, 5rem) clamp(3.5rem, 7vw, 5.5rem);
	}

	.hero-content {
		flex: 1 1 34rem;
		max-width: 40rem;
	}

	.hero-content h1 {
		font-size: clamp(2.5rem, 2rem + 2.5vw, 3.75rem);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.025em;
		background: linear-gradient(135deg, #ffffff, var(--accent-soft));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 1.25rem;
	}

	.hero-role {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
		color: var(--accent-soft);
		font-weight: 500;
		line-height: 1.5;
		margin-bottom: 1.5rem;
	}

	.hero-role :global(.hero-role-icon) {
		width: 1.1em;
		height: 1.1em;
		color: var(--accent);
		flex-shrink: 0;
	}

	.hero-copy {
		font-size: 1.0625rem;
		line-height: 1.85;
		color: var(--ink-muted);
		max-width: 34rem;
		margin-bottom: 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-mark {
		flex: 0 0 auto;
		width: clamp(5.5rem, 8vw, 7rem);
		height: clamp(5.5rem, 8vw, 7rem);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--accent-strong), #4f46e5);
		box-shadow:
			0 25px 50px -15px rgba(124, 58, 237, 0.45),
			0 0 0 1px rgba(255, 255, 255, 0.08) inset;
		animation: float 7s ease-in-out infinite;
	}

	.hero-mark span {
		font-size: clamp(1.5rem, 2vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-mark {
			animation: none;
		}
	}

	/* ---------- Profile ---------- */
	.profile-text {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 50rem;
	}

	.profile-text p {
		font-size: 1.0625rem;
		line-height: 1.9;
		color: var(--ink-muted);
	}

	/* ---------- Experience (identical treatment to what the homepage used
	   to show — this is now its canonical, more detailed home) ---------- */
	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.experience-item {
		padding: 1.75rem 2rem;
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition:
			border-color 0.35s ease,
			background-color 0.35s ease;
	}

	.experience-item:hover,
	.experience-item:focus-within {
		background: var(--glass-bg-strong);
		border-color: var(--glass-border-strong);
	}

	.experience-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-bottom: 0.6rem;
	}

	.experience-role {
		display: inline-flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.experience-title {
		font-weight: 600;
		font-size: 1.0625rem;
		color: var(--ink);
	}

	.experience-dash {
		color: var(--ink-subtle);
	}

	.experience-company {
		color: var(--accent-soft);
		font-weight: 500;
	}

	.experience-period {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-subtle);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.experience-description {
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
		max-width: 52rem;
	}

	/* ---------- Industries ---------- */
	.industry-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.industry-card {
		padding: 1.5rem 1.75rem;
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition:
			border-color 0.35s ease,
			background-color 0.35s ease;
	}

	.industry-card:hover {
		background: var(--glass-bg-strong);
		border-color: var(--glass-border-strong);
	}

	.industry-title {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ink);
		margin-bottom: 0.9rem;
	}

	.industry-tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.industry-tag {
		font-size: 0.8125rem;
		color: var(--ink-muted);
		background: rgba(167, 139, 250, 0.1);
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
	}

	/* ---------- Technical expertise ---------- */
	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.expertise-card {
		padding: 1.75rem;
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition:
			border-color 0.35s ease,
			background-color 0.35s ease;
	}

	.expertise-card:hover {
		background: var(--glass-bg-strong);
		border-color: var(--glass-border-strong);
	}

	.expertise-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		background: rgba(167, 139, 250, 0.12);
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.expertise-icon :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	.expertise-title {
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--ink);
		margin-bottom: 0.6rem;
	}

	.expertise-skills {
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
	}

	.expertise-note {
		margin-top: 1.5rem;
		font-size: 0.9375rem;
		color: var(--ink-subtle);
	}

	/* ---------- Training ---------- */
	.training-text {
		font-size: 1.0625rem;
		line-height: 1.9;
		color: var(--ink-muted);
		max-width: 50rem;
	}

	/* ---------- Education & certifications ---------- */
	.education-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2rem;
	}

	.education-degree {
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--ink);
		margin-bottom: 0.4rem;
	}

	.education-institution {
		font-size: 0.9375rem;
		color: var(--accent-soft);
		margin-bottom: 0.9rem;
	}

	.education-coursework {
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
	}

	.certifications-label {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--ink-subtle);
		margin-bottom: 0.9rem;
	}

	.cert-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.cert-badge {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--accent-soft);
		background: rgba(167, 139, 250, 0.1);
		border: 1px solid var(--glass-border-strong);
		border-radius: 999px;
		padding: 0.4rem 0.9rem;
	}

	/* ---------- Philosophy ---------- */
	.philosophy-text {
		font-size: 1.1875rem;
		line-height: 1.85;
		color: var(--ink-muted);
		max-width: 46rem;
	}

	/* ---------- Timeline ---------- */
	.timeline-list {
		list-style: none;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-inline-start: 2rem;
	}

	.timeline-list::before {
		content: '';
		position: absolute;
		inset-inline-start: 0.3125rem;
		top: 0.4rem;
		bottom: 0.4rem;
		width: 1.5px;
		background: var(--glass-border-strong);
	}

	.timeline-item {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1.25rem;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		inset-inline-start: -2rem;
		top: 0.3rem;
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.16);
	}

	.timeline-period {
		flex: 0 0 auto;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--accent-soft);
		letter-spacing: 0.01em;
		font-variant-numeric: tabular-nums;
		min-width: 9rem;
	}

	.timeline-title {
		font-size: 1rem;
		color: var(--ink);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 900px) {
		.industry-grid,
		.expertise-grid {
			grid-template-columns: 1fr;
		}
		.education-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 720px) {
		.hero-inner {
			flex-direction: column-reverse;
			text-align: center;
			gap: 2rem;
		}
		.hero-content {
			max-width: none;
		}
		.hero-copy {
			margin-inline: auto;
		}
		.hero-role,
		.hero-actions {
			justify-content: center;
		}
		.profile-text,
		.training-text,
		.philosophy-text {
			max-width: none;
		}
		.timeline-period {
			min-width: 100%;
		}
	}
</style>

<script>
	import { initGlassInteractions } from '../lib/glassInteractions';
	initGlassInteractions();
</script>
